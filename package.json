{
  "name": "finebykay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run content:generate && tsc -b && vite build && node scripts/generate-set-pages.mjs && node scripts/generate-policy-pages.mjs && node scripts/generate-notices.mjs",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "content:generate": "node scripts/generate-content.mjs",
    "predev": "npm run content:generate",
    "test:content": "node --test scripts/content.test.mjs",
    "test:security": "python3 -m unittest discover -s scripts -p test_security.py && python3 scripts/check-security.py --history && node --test scripts/security-baseline.test.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "framer-motion": "12.23.24",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "overrides": {
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "js-yaml": "4.3.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.3.8"
  }
}

